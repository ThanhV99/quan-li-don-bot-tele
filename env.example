# Biến môi trường cho project bot (chỉ phần Telegram, mọi dữ liệu / logic gọi API của web).
# Chép thành .env rồi điền giá trị:  cd bot && cp env.example .env
# KHÔNG đưa file .env thật lên git.

# ---------- bắt buộc ----------

# Token gọi web API – phải GIỐNG HỆT SERVICE_TOKEN bên web (tạo: openssl rand -hex 32).
SERVICE_TOKEN=

# Token bot Telegram chính (@BotFather).
BOT_TOKEN=

# Id Telegram được dùng bot (admin), cách nhau dấu phẩy. Để trống = không ai dùng được.
ALLOWED_USER_IDS=

# Giờ Việt Nam (Dockerfile đã đặt sẵn).
TZ=Asia/Ho_Chi_Minh

# ---------- không bắt buộc ----------

# Địa chỉ web API. Mặc định (bỏ trống) = http://quan-li-don-web:8000: web cùng máy, cùng mạng docker quan-li-don.
# Web ở máy khác: http://<máy web>:8088 · web trên Render: https://<tên-app>.onrender.com
# Chạy bot ngoài Docker, web trên cùng máy: http://127.0.0.1:8088
API_URL=

# Bot thứ 2 chuyên gửi thông báo vận chuyển (bot chạy polling của nó: /start xin nhận tin, /danggiao).
# Việc tự tra hành trình + gửi alert chạy ở WEB (đặt cùng token này trong .env của web). Trống = không có bot alert.
ALERT_BOT_TOKEN=

# Admin nhận thông báo vận chuyển (phải GIỐNG ALERT_CHAT_IDS bên web). Để trống = các id trong ALLOWED_USER_IDS.
ALERT_CHAT_IDS=

# Proxy dự phòng khi kết nối thẳng tới Telegram / web API (web ở xa: Vercel, Render) lỗi (để trống = luôn đi thẳng).
PROXY_URL=

# Thời gian chờ mỗi lời gọi web API (giây).
API_TIMEOUT=30
